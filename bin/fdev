#!/usr/bin/env bash

set -eo pipefail

SOURCE="${BASH_SOURCE[0]}"

while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"

  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$SOURCE_DIR/$SOURCE"
  fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
FDEV_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE_DIR="$FDEV_ROOT/templates/base"

PROJECT_DIR="$PWD"

source "$SCRIPT_DIR/lib/output.sh"
source "$SCRIPT_DIR/lib/docker.sh"
source "$SCRIPT_DIR/lib/env.sh"
source "$SCRIPT_DIR/lib/args.sh"
source "$SCRIPT_DIR/lib/project.sh"
source "$SCRIPT_DIR/lib/system.sh"

NODE_VERSION_FILE="$PROJECT_DIR/.node-version"
NODE_VERSION=""

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  help|--help|-h|doctor|install-cli|init)
    ;;
  *)
    require_fdev_project
    load_node_version
    check_docker
    ;;
esac

parse_args "$@"
set -- "${COMMAND_ARGS[@]}"

case "$COMMAND" in
  up)
    show_env_hint
    compose "${COMPOSE_ARGS[@]}" up -d "$@"
    ;;

  stop)
    compose "${COMPOSE_ARGS[@]}" stop "$@"
    ;;

  down)
    compose "${COMPOSE_ARGS[@]}" down "$@"
    ;;

  destroy)
    warn "This will remove containers and project volumes."
    read -r -p "Continue? [y/N] " answer

    case "$answer" in
      y|Y|yes|YES)
        compose down --volumes --remove-orphans
        ;;
      *)
        info "Cancelled."
        ;;
    esac
    ;;

  restart)
    compose "${COMPOSE_ARGS[@]}" restart "$@"
    ;;

  rebuild)
    show_env_hint
    compose "${COMPOSE_ARGS[@]}" up -d --build "$@"
    ;;

  shell)
    require_running
    compose exec app bash "$@"
    ;;

  exec)
    require_running

    if [[ $# -eq 0 ]]; then
      error "Usage: fdev exec <command> [arguments...]"
      exit 1
    fi

    compose exec app "$@"
    ;;

  node)
    require_running
    compose exec app node "$@"
    ;;

  pnpm)
    require_running
    compose exec app pnpm "$@"
    ;;

  init)
    initialize_project
    ;;

  install)
    require_running
    require_package_json

    info "installing dependencies"
    compose exec app pnpm install "$@"
    ;;

  dev)
    require_running

    if ! has_package_script "dev"; then
      error "package.json does not define a 'dev' script"
      info "add a dev script for your framework, for example Next.js or Vite"
      exit 1
    fi

    info "starting development server"
    compose exec app pnpm run dev "$@"
    ;;

  run)
    require_running
    require_package_json

    if [[ $# -eq 0 ]]; then
      error "usage: fdev run <script> [arguments...]"
      exit 1
    fi

    SCRIPT_NAME="$1"
    shift

    if ! has_package_script "$SCRIPT_NAME"; then
      error "package.json does not define a '$SCRIPT_NAME' script"
      exit 1
    fi

    info "running '$SCRIPT_NAME'"
    compose exec app pnpm run "$SCRIPT_NAME" "$@"
    ;;

  open)
    require_running

    APP_URL="$(get_app_url || true)"

    if [[ -z "$APP_URL" ]]; then
      error "application URL is not available"
      exit 1
    fi

    info "opening $APP_URL"
    open_url "$APP_URL"
    ;;

  logs)
    compose logs -f "$@"
    ;;

  ps)
    compose ps "$@"
    ;;

  install-cli)
    INSTALL_DIR="${FDEV_INSTALL_DIR:-$HOME/.local/share/fdev}"
    BIN_DIR="${FDEV_BIN_DIR:-$HOME/.local/bin}"

    info "installing fdev CLI"

    mkdir -p "$INSTALL_DIR/bin/lib"
    mkdir -p "$INSTALL_DIR/templates"
    mkdir -p "$BIN_DIR"

    cp "$SCRIPT_DIR/fdev" "$INSTALL_DIR/bin/fdev"
    cp "$SCRIPT_DIR/fe" "$INSTALL_DIR/bin/fe"
    cp "$SCRIPT_DIR/lib/"*.sh "$INSTALL_DIR/bin/lib/"

    rm -rf "$INSTALL_DIR/templates/base"
    cp -R "$FDEV_ROOT/templates/base" "$INSTALL_DIR/templates/base"
    cp "$FDEV_ROOT/package.json" "$INSTALL_DIR/package.json"

    chmod +x "$INSTALL_DIR/bin/fdev"
    chmod +x "$INSTALL_DIR/bin/fe"

    ln -sf "$INSTALL_DIR/bin/fdev" "$BIN_DIR/fdev"
    ln -sf "$INSTALL_DIR/bin/fe" "$BIN_DIR/fe"

    success "fdev CLI installed"
    info "installation: $INSTALL_DIR"
    info "commands:     $BIN_DIR/fdev, $BIN_DIR/fe"

    case ":$PATH:" in
      *":$BIN_DIR:"*)
        success "$BIN_DIR is in PATH"
        ;;
      *)
        warn "$BIN_DIR is not in PATH"
        info "add this line to your shell configuration:"
        echo
        printf '  export PATH="%s:$PATH"\n' "$BIN_DIR"
        ;;
    esac
    ;;

  doctor)
    info "checking development environment..."
    DOCTOR_FAILED=0

    if command -v docker >/dev/null 2>&1; then
      success "Docker is available"
    else
      error "Docker is not available"
      DOCTOR_FAILED=1
    fi

    if compose version >/dev/null 2>&1; then
      success "Docker Compose is available"
    else
      error "Docker Compose is not available"
      DOCTOR_FAILED=1
    fi

    if docker info >/dev/null 2>&1; then
      success "Docker daemon is running"
    else
      error "Docker daemon is not running"
      DOCTOR_FAILED=1
    fi

    NODE_VERSION_VALID=0

    if [[ -f "$NODE_VERSION_FILE" ]]; then
      NODE_VERSION="$(tr -d '[:space:]' < "$NODE_VERSION_FILE")"

      if [[ -n "$NODE_VERSION" ]]; then
        export NODE_VERSION
        NODE_VERSION_VALID=1
        success ".node-version exists ($NODE_VERSION)"
      else
        error ".node-version is empty"
        DOCTOR_FAILED=1
      fi
    else
      error ".node-version is missing"
      DOCTOR_FAILED=1
    fi

    if [[ -f "$PROJECT_DIR/package.json" ]]; then
      success "package.json exists"
    else
      error "package.json is missing"
      DOCTOR_FAILED=1
    fi

    if [[ -f "$PROJECT_DIR/.env" ]]; then
      success ".env exists"
    elif [[ -f "$PROJECT_DIR/.env.example" ]]; then
      warn ".env does not exist"
      info "defaults from compose.yaml will be used"
    else
      warn "neither .env nor .env.example exists"
    fi

    if [[ "$NODE_VERSION_VALID" -eq 1 ]]; then
      if is_running; then
        success "app container is running"

        load_runtime_versions

        if [[ -n "$NODE_RUNTIME_VERSION" ]]; then
          success "Node $NODE_RUNTIME_VERSION"
        else
          error "Node is not available in the app container"
          DOCTOR_FAILED=1
        fi

        if [[ -n "$PNPM_RUNTIME_VERSION" ]]; then
          success "pnpm $PNPM_RUNTIME_VERSION"
        else
          error "pnpm is not available in the app container"
          DOCTOR_FAILED=1
        fi

        if [[ -n "$COREPACK_RUNTIME_VERSION" ]]; then
          success "Corepack $COREPACK_RUNTIME_VERSION"
        else
          error "Corepack is not available in the app container"
          DOCTOR_FAILED=1
        fi
      else
        warn "app container is not running"
        info "run 'fdev up' to start the environment"
      fi
    else
      warn "runtime checks skipped because Node version is not configured"
    fi

    if [[ "$DOCTOR_FAILED" -ne 0 ]]; then
      error "environment check failed"
      exit 1
    fi

    if is_running; then
      success "environment looks healthy"
    else
      success "configuration looks healthy"
    fi
    ;;

  info)
    info "project information"

    echo
    printf "  Project:   %s\n" "$(basename "$PROJECT_DIR")"
    printf "  Path:      %s\n" "$PROJECT_DIR"

    echo
    info "services"

    if is_running; then
      success "app running"
    else
      warn "app stopped"
    fi

    if compose --profile db ps --status running --services | grep -q '^postgres$'; then
      DB_STATUS="$(
        docker inspect \
          --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
          "$(compose --profile db ps -q postgres)" \
          2>/dev/null || true
      )"

      if [[ "$DB_STATUS" == "healthy" ]]; then
        success "postgres healthy"
      else
        warn "postgres ${DB_STATUS:-running}"
      fi
    else
      warn "postgres stopped"
    fi

    if is_running; then
      APP_URL="$(get_app_url || true)"

      if [[ -n "$APP_URL" ]]; then
        echo
        info "application"

        printf "  URL:       %s\n" "$APP_URL"
      fi
    fi

    if is_running; then
      echo
      info "runtime"

      load_runtime_versions

      printf "  Node:      %s\n" "$NODE_RUNTIME_VERSION"
      printf "  pnpm:      %s\n" "$PNPM_RUNTIME_VERSION"
      printf "  Corepack:  %s\n" "$COREPACK_RUNTIME_VERSION"
    fi
    ;;

  version)
    load_runtime_versions

    info "runtime versions"

    printf "  Node:      %s\n" "$NODE_RUNTIME_VERSION"
    printf "  pnpm:      %s\n" "$PNPM_RUNTIME_VERSION"
    printf "  Corepack:  %s\n" "$COREPACK_RUNTIME_VERSION"
    ;;

  help|--help|-h)
    cat <<'HELP'
Frontend Development Environment

Usage:
  fdev <command>

Alias:
  fe          Short alias for fdev

Options:
  --db        Start optional PostgreSQL service

Environment:
  up          Start the environment
  stop        Stop containers without removing them
  down        Stop and remove containers
  restart     Restart containers
  rebuild     Rebuild images and start the environment
  destroy     Remove containers and project volumes

Setup:
  init        Initialize fdev in the current project
  install-cli Install fdev and fe globally

Development:
  shell       Open Bash inside the app container
  exec        Run any command inside the app container
  node        Run Node
  pnpm        Run pnpm
  install     Install project dependencies
  dev         Start project development server
  run         Run a package.json script
  open        Open application in the default browser

Information:
  logs        Follow container logs
  ps          Show container status
  info        Show project and runtime information
  version     Show runtime versions
  doctor      Check development environment
  help        Show this help

Configuration:
  Copy .env.example to .env to customize ports and database settings.

Host requirements:
  Docker with Docker Compose support
HELP
    ;;

  *)
    error "unknown command: $COMMAND"
    echo
    info "Run 'fdev help' for available commands."
    exit 1
    ;;
esac