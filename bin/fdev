#!/usr/bin/env bash

set -euo pipefail

NODE_VERSION_FILE=".node-version"

if [[ ! -f "$NODE_VERSION_FILE" ]]; then
  echo "fdev: missing .node-version"
  exit 1
fi

NODE_VERSION="$(tr -d '[:space:]' < "$NODE_VERSION_FILE")"

if [[ -z "$NODE_VERSION" ]]; then
  echo "fdev: .node-version is empty"
  exit 1
fi

export NODE_VERSION

COMMAND="${1:-help}"
shift || true

is_running() {
  docker compose ps --status running --services | grep -q '^app$'
}

require_running() {
  if ! is_running; then
    echo "fdev: environment is not running."
    echo "Run: fdev up"
    exit 1
  fi
}

case "$COMMAND" in
  up)
    docker compose up -d "$@"
    ;;

  stop)
    docker compose stop "$@"
    ;;

  down)
    docker compose down "$@"
    ;;

  destroy)
    echo "This will remove containers and project volumes."
    read -r -p "Continue? [y/N] " answer

    case "$answer" in
      y|Y|yes|YES)
        docker compose down --volumes --remove-orphans
        ;;
      *)
        echo "Cancelled."
        ;;
    esac
    ;;

  restart)
    docker compose restart "$@"
    ;;

  rebuild)
    docker compose up -d --build "$@"
    ;;

  shell)
    require_running
    docker compose exec app bash "$@"
    ;;

  exec)
    require_running

    if [[ $# -eq 0 ]]; then
      echo "Usage: fdev exec <command> [arguments...]"
      exit 1
    fi

    docker compose exec app "$@"
    ;;

  node)
    require_running
    docker compose exec app node "$@"
    ;;

  pnpm)
    require_running
    docker compose exec app pnpm "$@"
    ;;

  logs)
    docker compose logs -f "$@"
    ;;

  ps)
    docker compose ps "$@"
    ;;

  info)
    echo "Frontend Development Environment"
    echo
    echo "Project:   $(basename "$PWD")"
    echo "Path:      $PWD"
    echo "Node:      $NODE_VERSION"

    if is_running; then
      echo "Status:    running"
      echo
      echo "Runtime:"
      echo "  Node:     $(docker compose exec -T app node --version)"
      echo "  pnpm:     $(docker compose exec -T app pnpm --version)"
      echo "  Corepack: $(docker compose exec -T app corepack --version)"
    else
      echo "Status:    stopped"
    fi
    ;;

  version)
    require_running
    echo "Node:     $(docker compose exec -T app node --version)"
    echo "pnpm:     $(docker compose exec -T app pnpm --version)"
    echo "Corepack: $(docker compose exec -T app corepack --version)"
    ;;

  help|--help|-h)
    cat <<'HELP'
Frontend Development Environment

Usage:
  fdev <command>

Environment:
  up          Start the environment
  stop        Stop containers without removing them
  down        Stop and remove containers
  restart     Restart containers
  rebuild     Rebuild images and start the environment
  destroy     Remove containers and project volumes

Development:
  shell       Open Bash inside the app container
  exec        Run any command inside the app container
  node        Run Node
  pnpm        Run pnpm

Information:
  logs        Follow container logs
  ps          Show container status
  info        Show project and runtime information
  version     Show runtime versions
  help        Show this help
HELP
    ;;

  *)
    echo "fdev: unknown command: $COMMAND"
    echo
    echo "Run 'fdev help' for available commands."
    exit 1
    ;;
esac
