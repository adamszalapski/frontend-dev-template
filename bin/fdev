#!/usr/bin/env bash

set -eo pipefail

check_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "fdev: Docker is not installed or not available on PATH."
    exit 1
  fi

  if ! docker compose version >/dev/null 2>&1; then
    echo "fdev: Docker Compose is not available."
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo "fdev: Docker daemon is not running."
    exit 1
  fi
}

show_env_hint() {
  if [[ ! -f ".env" && -f ".env.example" ]]; then
    echo "fdev: using default environment values."
    echo "fdev: copy .env.example to .env to customize them."
  fi
}

NODE_VERSION_FILE=".node-version"

if [[ ! -f "$NODE_VERSION_FILE" ]]; then
  echo "fdev: missing .node-version"
  exit 1
fi

NODE_VERSION="$(tr -d '[:space:]' < "$NODE_VERSION_FILE")"

if [[ -z "$NODE_VERSION" ]]; then
  echo "fdev: .node-version is empty"
  exit 1
fi

export NODE_VERSION

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  help|--help|-h)
    ;;
  *)
    check_docker
    ;;
esac

COMPOSE_ARGS=()
COMMAND_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --db)
      COMPOSE_ARGS+=(--profile db)
      ;;
    *)
      COMMAND_ARGS+=("$arg")
      ;;
  esac
done

set -- "${COMMAND_ARGS[@]}"

is_running() {
  docker compose ps --status running --services | grep -q '^app$'
}

require_running() {
  if ! is_running; then
    echo "fdev: environment is not running."
    echo "Run: fdev up"
    exit 1
  fi
}

case "$COMMAND" in
  up)
    show_env_hint
    docker compose "${COMPOSE_ARGS[@]}" up -d "$@"
    ;;

  stop)
    docker compose "${COMPOSE_ARGS[@]}" stop "$@"
    ;;

  down)
    docker compose "${COMPOSE_ARGS[@]}" down "$@"
    ;;

  destroy)
    echo "This will remove containers and project volumes."
    read -r -p "Continue? [y/N] " answer

    case "$answer" in
      y|Y|yes|YES)
        docker compose down --volumes --remove-orphans
        ;;
      *)
        echo "Cancelled."
        ;;
    esac
    ;;

  restart)
    docker compose "${COMPOSE_ARGS[@]}" restart "$@"
    ;;

  rebuild)
    show_env_hint
    docker compose "${COMPOSE_ARGS[@]}" up -d --build "$@"
    ;;

  shell)
    require_running
    docker compose exec app bash "$@"
    ;;

  exec)
    require_running

    if [[ $# -eq 0 ]]; then
      echo "Usage: fdev exec <command> [arguments...]"
      exit 1
    fi

    docker compose exec app "$@"
    ;;

  node)
    require_running
    docker compose exec app node "$@"
    ;;

  pnpm)
    require_running
    docker compose exec app pnpm "$@"
    ;;

  logs)
    docker compose logs -f "$@"
    ;;

  ps)
    docker compose ps "$@"
    ;;

  info)
    echo "Frontend Development Environment"
    echo
    echo "Project:   $(basename "$PWD")"
    echo "Path:      $PWD"
    echo "Node:      $NODE_VERSION"
    echo

    echo "Services:"

    if docker compose ps --status running --services | grep -q '^app$'; then
      echo "  app       running"
    else
      echo "  app       stopped"
    fi

    if docker compose --profile db ps --status running --services | grep -q '^postgres$'; then
      DB_STATUS="$(docker inspect \
        --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
        "$(docker compose --profile db ps -q postgres)" 2>/dev/null || true)"

      echo "  postgres  ${DB_STATUS:-running}"
    else
      echo "  postgres  stopped"
    fi

    if is_running; then
      echo
      echo "Runtime:"
      echo "  Node:     $(docker compose exec -T app node --version)"
      echo "  pnpm:     $(docker compose exec -T app pnpm --version)"
      echo "  Corepack: $(docker compose exec -T app corepack --version)"
    fi
    ;;

  version)
    require_running
    echo "Node:     $(docker compose exec -T app node --version)"
    echo "pnpm:     $(docker compose exec -T app pnpm --version)"
    echo "Corepack: $(docker compose exec -T app corepack --version)"
    ;;

  help|--help|-h)
    cat <<'HELP'
Frontend Development Environment

Usage:
  fdev <command>

Options:
  --db        Start optional PostgreSQL service

Environment:
  up          Start the environment
  stop        Stop containers without removing them
  down        Stop and remove containers
  restart     Restart containers
  rebuild     Rebuild images and start the environment
  destroy     Remove containers and project volumes

Development:
  shell       Open Bash inside the app container
  exec        Run any command inside the app container
  node        Run Node
  pnpm        Run pnpm

Information:
  logs        Follow container logs
  ps          Show container status
  info        Show project and runtime information
  version     Show runtime versions
  help        Show this help

Configuration:
  Copy .env.example to .env to customize ports and database settings.

Host requirements:
  Docker with Docker Compose support
HELP
    ;;

  *)
    echo "fdev: unknown command: $COMMAND"
    echo
    echo "Run 'fdev help' for available commands."
    exit 1
    ;;
esac
